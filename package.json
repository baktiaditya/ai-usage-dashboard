{
  "name": "ai-usage-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3838",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3838",
    "collect": "tsx scripts/collect.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "claude:install-statusline": "tsx scripts/install-claude-statusline.ts",
    "systemd:install": "bash scripts/install-systemd.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE_SMOKE=1 vitest run --config vitest.live.config.ts",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "db:build-migrations": "tsx scripts/build-migrations.ts",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "better-sqlite3": "12.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "0.544.0",
    "next": "16.3.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.3.1",
    "zod": "4.1.11"
  },
  "allowScripts": {
    "better-sqlite3@12.4.1": true,
    "@tailwindcss/oxide@4.1.13": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.1.13",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "9.36.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "27.0.0",
    "postcss": "8.5.28",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "5.0.0"
  }
}
