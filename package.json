  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "tsx scripts/next.ts dev",
    "build": "next build",
    "start": "tsx scripts/next.ts start",
    "collect": "tsx scripts/collect.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "claude:install-statusline": "tsx scripts/install-claude-statusline.ts",
    "systemd:install": "bash scripts/install-systemd.sh",
    "lint": "eslint .",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE_SMOKE=1 vitest run --config vitest.live.config.ts",
    "test:e2e": "playwright test",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "db:build-migrations": "tsx scripts/build-migrations.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:dev": "tsx scripts/seed-demo.ts --dev",
    "test:installation": "vitest run tests/unit/installation.test.ts tests/integration/installation.test.ts",
    "test:installation:systemd": "bash scripts/test-installation-systemd.sh"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "better-sqlite3": "12.4.1",
