    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "0.544.0",
    "next": "16.3.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.3.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
