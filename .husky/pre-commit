# Husky can run from a Git GUI with a minimal PATH. Keep node and corepack's
# pnpm reachable without assuming where Node lives: use PATH when it already
# has them, otherwise fall back to an nvm installation when present and to the
# usual user, Homebrew and system locations.
if ! command -v node >/dev/null 2>&1 || ! command -v pnpm >/dev/null 2>&1; then
  nvm_dir="${NVM_DIR:-$HOME/.nvm}"
  nvm_bin=$(ls -d "$nvm_dir"/versions/node/*/bin 2>/dev/null | sort -V | tail -1)
  # A found nvm toolchain stays ahead of the general locations, so an older
  # system Node can never shadow the supported one.
  PATH="${nvm_bin:+$nvm_bin:}$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:$PATH"
  export PATH
fi
if ! command -v node >/dev/null 2>&1 || ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-commit: node and pnpm must be on PATH; run 'corepack enable pnpm' once" >&2
  exit 1
fi

# Format staged files first (auto-restages).
pnpm exec lint-staged || exit 1

# Skip type/test checks when no TS/TSX is staged (e.g. docs-only commits).
staged_ts=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx')
if [ -z "$staged_ts" ]; then
  exit 0
fi

# Run typecheck (whole project) and affected tests (staged files only) in parallel.
pnpm run typecheck &
typecheck_pid=$!
pnpm exec vitest related --run --passWithNoTests $staged_ts &
test_pid=$!

status=0
wait "$typecheck_pid" || status=1
wait "$test_pid" || status=1

exit "$status"
