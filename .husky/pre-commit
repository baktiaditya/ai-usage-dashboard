# Husky can run with a minimal PATH. Fail loudly when node or corepack's pnpm
# shim is missing instead of assuming an nvm installation.
if ! command -v node >/dev/null 2>&1 || ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-commit: node and pnpm must be on PATH; run 'corepack enable pnpm' once" >&2
  exit 1
fi

# Format staged files first (auto-restages).
pnpm exec lint-staged || exit 1

# Skip type/test checks when no TS/TSX is staged (e.g. docs-only commits).
staged_ts=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx')
if [ -z "$staged_ts" ]; then
  exit 0
fi

# Run typecheck (whole project) and affected tests (staged files only) in parallel.
pnpm run typecheck &
typecheck_pid=$!
pnpm exec vitest related --run --passWithNoTests $staged_ts &
test_pid=$!

status=0
wait "$typecheck_pid" || status=1
wait "$test_pid" || status=1

exit "$status"
