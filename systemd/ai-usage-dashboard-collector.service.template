# user-level systemd service — installed to ~/.config/systemd/user/
#
# Placeholders are substituted with absolute paths by scripts/install-systemd.sh.
# This unit is NEVER installed or enabled automatically.
[Unit]
Description=AI Usage Dashboard collector (one-shot)
Documentation=file://__WORKDIR__/docs/operations/setup.md
# Do not fight the network at boot; a failed poll is a normal, recorded outcome.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__WORKDIR__
ExecStart=__NODE__ __TSX__ __WORKDIR__/scripts/collect.ts

# A user service has no PATH from the login shell. The Codex adapter spawns
# `codex` by name, and an nvm-installed codex is itself a `#!/usr/bin/env node`
# script, so naming node absolutely in ExecStart is not enough on its own.
Environment=PATH=__PATH__
Environment=CODEX_HOME=__CODEXHOME__

# Resolved by the installer with the collector's own precedence, so the timer,
# the writable data path below, and the collector agree. There is deliberately
# no `EnvironmentFile=`: systemd would let the file override these values. The
# collector loads that file itself for optional AUD_* settings and fills only
# unset variables, which keeps these authoritative. An absent file is fine.
# Provider keys never come from it; they are saved in dashboard Settings.
Environment="AUD_ENV_FILE=__ENVFILE__"
Environment="AUD_DATA_DIR=__DATADIR__"
Environment=AUD_COLLECT_INTERVAL_MINUTES=__INTERVAL__

# Never let a hung provider hold a slot; the collector's own per-adapter
# timeouts are shorter, so reaching this is already an anomaly.
TimeoutStartSec=120

# Files this unit creates (database, spool, WAL) stay owner-only.
UMask=0077

# The collector reads two local sources and makes two outbound HTTPS calls.
# Everything below removes capability it demonstrably does not need.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__DATADIR__
# `codex app-server` writes its own state under CODEX_HOME and exits early when
# that directory is read-only. `-` keeps the unit valid on a machine without Codex.
ReadWritePaths=-__CODEXHOME__
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
