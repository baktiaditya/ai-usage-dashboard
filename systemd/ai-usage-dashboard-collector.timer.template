# user-level systemd timer — installed to ~/.config/systemd/user/
[Unit]
Description=Run the AI Usage Dashboard collector every __INTERVAL__ minutes
Documentation=file://__WORKDIR__/docs/operations/setup.md

[Timer]
# Anchor the first run to the timer's own activation; a bare OnBootSec= one-shot
# can be disabled by a re-evaluation after its deadline. Setup explains why.
OnActiveSec=2min
# Monotonic, so it pauses during suspend and resumes its countdown afterwards;
# there is no catch-up run after a resume.
OnUnitActiveSec=__INTERVAL__min
# Spread the wake-up so a laptop resuming from sleep does not fire every timer
# in the same instant.
AccuracySec=30s
RandomizedDelaySec=30s
# Deliberately no Persistent=: its stamp sets last_trigger, which systemd 255
# uses to disable a past one-shot. It buys nothing for a monotonic timer.
Unit=ai-usage-dashboard-collector.service

[Install]
WantedBy=timers.target
