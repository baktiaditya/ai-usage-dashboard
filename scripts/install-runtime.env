# Managed runtime manifest (data, never shell).
#
# scripts/install.sh parses these two keys line by line and refuses anything
# else. The Node release is the first pin from the supported Node 24 line
# (.nvmrc, engines.node). Node 25 and later no longer ship Corepack, which the
# pnpm provisioning step depends on, so compatibility with .nvmrc and
# engines.node is validated before download (src/lib/installation/manifest.ts
# and its unit tests). The checksum is the official
# https://nodejs.org/dist/v24.19.0/SHASUMS256.txt value for the Linux x64
# archive.
NODE_VERSION=24.19.0
NODE_SHA256_LINUX_X64=14b342e71204f811bde6153be8e04b62aef63c236fef92b55f9c83154b409647
