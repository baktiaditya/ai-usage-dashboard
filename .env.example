# ---------------------------------------------------------------------------
# AI Usage Dashboard — example environment
#
# Every setting is optional. To override one, copy the lines you need to an
# environment file OUTSIDE the repository (recommended:
# ~/.config/ai-usage-dashboard/collector.env with mode 0600).
# See docs/operations/setup.md.
#
# DeepSeek and OpenRouter keys do not belong here. Save them in the dashboard's
# Settings dialog, which stores them in the local database.
# ---------------------------------------------------------------------------

# --- optional overrides (safe defaults shipped in src/lib/config) ----------
# Paths must be absolute or start with ~/ (expanded here, unlike in a shell).
# AUD_DATA_DIR=/home/you/.local/share/ai-usage-dashboard
# Calendar-day boundaries follow the system timezone Node resolves, falling
# back to UTC when none resolves. Set AUD_TIMEZONE to pin one instead.
# AUD_TIMEZONE=America/New_York
# AUD_HOST=127.0.0.1
# AUD_PORT=3838
# AUD_RETENTION_DAYS=90
# AUD_LOG_LEVEL=info
# Extra exact https origins the same-origin guard also accepts, so manual refresh
# and Settings work when the dashboard is reached through `tailscale serve`
# (docs/operations/setup.md §6). https only; no trailing slash, path, query, or
# port. Comma-separate several.
# AUD_ALLOWED_ORIGINS=https://machine.tailnet.ts.net

# --- development server: pnpm run dev and pnpm run seed:dev only -----------
# Ignored by pnpm run start, pnpm run collect, and the systemd units.
# AUD_DEV_PORT must differ from AUD_PORT, and AUD_DEV_DATA_DIR from the
# production data directory. AUD_DEV_LIVE_REFRESH accepts only 0 or 1 (never
# blank); 1 lets manual refresh in development collect with the keys saved in
# the development server's own Settings, and write the development database.
# AUD_DEV_PORT=3839
# AUD_DEV_DATA_DIR=/home/you/.local/share/ai-usage-dashboard-dev
# AUD_DEV_LIVE_REFRESH=0
