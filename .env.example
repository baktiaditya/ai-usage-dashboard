# ---------------------------------------------------------------------------
# AI Usage Dashboard — example environment
#
# Copy to an environment file OUTSIDE the repository (recommended:
# ~/.config/ai-usage-dashboard/collector.env with mode 0600) and fill it in.
# Never commit a real key. See docs/operations/SETUP.md.
# ---------------------------------------------------------------------------

# DeepSeek platform API key. Used only for GET /user/balance.
# Absent -> the DeepSeek card renders as "unavailable", never as an error.
DEEPSEEK_API_KEY=

# OpenRouter *Management* key (https://openrouter.ai/settings/management-keys).
# GET /api/v1/credits rejects ordinary inference keys with HTTP 403.
# This is a high-impact administrative credential: file mode 0600, never sent
# to the browser, never logged. Absent -> "unavailable".
OPENROUTER_MANAGEMENT_KEY=

# --- optional overrides (safe defaults shipped in src/lib/config) ----------
# Paths must be absolute or start with ~/ (expanded here, unlike in a shell).
# AUD_DATA_DIR=/home/you/.local/share/ai-usage-dashboard
# AUD_TIMEZONE=Asia/Jakarta
# AUD_HOST=127.0.0.1
# AUD_PORT=3838
# AUD_RETENTION_DAYS=90
# AUD_LOG_LEVEL=info
